# Supabase Configuration
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# Resend Configuration (for email)
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Dashboard Configuration
NEXT_PUBLIC_DASHBOARD_PASSWORD=your_secure_password_here

# Application URL (IMPORTANT: Update this for production!)
# For local development: http://localhost:3000
# For production (Vercel): https://your-app-name.vercel.app
# Example: https://psych-asrs-one.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IntakeQ Integration (Optional but recommended)
# Get these from IntakeQ Settings > Integrations > Developer API
INTAKEQ_API_KEY=your_intakeq_api_key_here
INTAKEQ_API_URL=https://intakeq.com/api/v1
INTAKEQ_PRACTITIONER_ID=your_practitioner_id_here
# Optional: If you have multiple locations
INTAKEQ_LOCATION_ID=your_location_id_here
